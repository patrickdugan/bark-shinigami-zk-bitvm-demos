+use std::fs;
+use std::io::Read;
+use std::path::PathBuf;
+
+use anyhow::{bail, Context, Result};
+use bincode::Options;
+use bzip2::bufread::BzDecoder;
+use cairo_air::utils::{get_verification_output, VerificationOutput};
+use cairo_air::verifier::{verify_cairo, INTERACTION_POW_BITS};
+use cairo_air::CairoProofForRustVerifier;
+use clap::Parser;
+use serde::Serialize;
+use stwo::core::vcs_lifted::blake2_merkle::{Blake2sMerkleChannel, Blake2sMerkleHasher};
+use stwo_cairo_common::preprocessed_columns::preprocessed_trace::PreProcessedTraceVariant;
+
+const MAX_DECOMPRESSED_PROOF_BYTES: u64 = 512 * 1024 * 1024;
+
+#[derive(Parser, Debug)]
+struct Args {
+    /// Path to a bzip2-compressed bincode Cairo proof.
+    #[arg(long = "proof_path")]
+    proof_path: PathBuf,
+}
+
+#[derive(Serialize)]
+struct VerifiedOutput {
+    program_hash: String,
+    output: Vec<String>,
+}
+
+impl From<VerificationOutput> for VerifiedOutput {
+    fn from(value: VerificationOutput) -> Self {
+        Self {
+            program_hash: format!("{:#x}", value.program_hash),
+            output: value
+                .output
+                .into_iter()
+                .map(|felt| format!("{felt:#x}"))
+                .collect(),
+        }
+    }
+}
+
+fn read_strict_binary(
+    proof_path: &PathBuf,
+) -> Result<CairoProofForRustVerifier<Blake2sMerkleHasher>> {
+    let compressed = fs::read(proof_path).context("read compressed proof")?;
+    let mut decompressed = Vec::new();
+    let mut decoder = BzDecoder::new(compressed.as_slice());
+    (&mut decoder)
+        .take(MAX_DECOMPRESSED_PROOF_BYTES + 1)
+        .read_to_end(&mut decompressed)
+        .context("decompress proof")?;
+    if decompressed.len() as u64 > MAX_DECOMPRESSED_PROOF_BYTES {
+        bail!("decompressed proof exceeds limit");
+    }
+    if decoder.total_in() != compressed.len() as u64 {
+        bail!("trailing bytes after compressed proof stream");
+    }
+
+    bincode::DefaultOptions::new()
+        .with_fixint_encoding()
+        .with_limit(MAX_DECOMPRESSED_PROOF_BYTES)
+        .reject_trailing_bytes()
+        .deserialize(&decompressed)
+        .context("deserialize one canonical proof object")
+}
+
+fn enforce_policy(proof: &CairoProofForRustVerifier<Blake2sMerkleHasher>) -> Result<()> {
+    let config = proof.stark_proof.config;
+    if proof.channel_salt != 0
+        || config.pow_bits != 26
+        || config.fri_config.log_blowup_factor != 1
+        || config.fri_config.n_queries != 70
+        || config.fri_config.log_last_layer_degree_bound != 0
+        || config.fri_config.fold_step != 1
+        || config.lifting_log_size.is_some()
+        || proof.preprocessed_trace_variant != PreProcessedTraceVariant::Canonical
+        || INTERACTION_POW_BITS != 24
+    {
+        bail!("proof does not use the pinned StwoPolicyV1");
+    }
+    Ok(())
+}
+
+fn main() -> Result<()> {
+    let args = Args::parse();
+    let proof = read_strict_binary(&args.proof_path)?;
+    enforce_policy(&proof)?;
+    let public_output = get_verification_output(&proof.claim.public_data.public_memory);
+
+    verify_cairo::<Blake2sMerkleChannel>(proof)?;
+
+    println!(
+        "{}",
+        serde_json::to_string_pretty(&VerifiedOutput::from(public_output))?
+    );
+    Ok(())
+}
